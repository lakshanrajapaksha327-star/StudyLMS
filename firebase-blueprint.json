      "title": "UserProfileDoc",
      "description": "Authenticated user profile and study progress metrics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 320 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "role": { "type": "string", "enum": ["Student", "Educator", "Admin"] },
        "studyGoalMinutes": { "type": "number" },
        "streakDays": { "type": "number" },
        "cardsMastered": { "type": "number" },
        "quizzesCompleted": { "type": "number" },
        "timeSpentMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "updatedAt"]
    },

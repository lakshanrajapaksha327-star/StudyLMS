# AI PROVIDER SECRETS (Configure via Google AI Studio Server-Side Secrets)
# Never hardcode real API keys in source files.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# CENTRALIZED MULTI-PROVIDER AI CONFIGURATION
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="openai"
AI_EMBEDDING_PROVIDER="gemini"

# GEMINI PER-TASK MODELS
GEMINI_SIMPLE_MODEL="gemini-3.1-flash-lite"
GEMINI_COMPLEX_MODEL="gemini-4-hydrogen"
GEMINI_MULTIMODAL_MODEL="gemini-4-hydrogen"
GEMINI_STRUCTURED_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# OPENAI PER-TASK MODELS
OPENAI_SIMPLE_MODEL="gpt-4o-mini"
OPENAI_COMPLEX_MODEL="gpt-4o"
OPENAI_MULTIMODAL_MODEL="gpt-4o"
OPENAI_STRUCTURED_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# ANTHROPIC PER-TASK MODELS
ANTHROPIC_SIMPLE_MODEL="claude-haiku-4-5"
ANTHROPIC_COMPLEX_MODEL="claude-sonnet-4-5"
ANTHROPIC_MULTIMODAL_MODEL="claude-sonnet-4-5"
ANTHROPIC_STRUCTURED_MODEL="claude-haiku-4-5"

# ADMIN AUTHORIZATION (Comma-separated Firebase UIDs or verified email addresses)
ADMIN_UIDS=""
ADMIN_EMAILS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT="3000"

